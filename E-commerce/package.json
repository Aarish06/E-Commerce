{
  "name": "ecommerce-monorepo",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start:frontend": "npm run dev --workspace=@ecommerce/frontend",
    "start:backend": "npm run dev --workspace=@ecommerce/backend",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\""
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^16.0.0"
  }
}